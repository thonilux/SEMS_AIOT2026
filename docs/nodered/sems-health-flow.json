  {
    "id": "node-status-format",
    "type": "function",
    "z": "sems-health-tab",
    "name": "format status",
    "func": "const p = msg.payload;\nconst devId = msg.topic.split('/')[1] || '?';\nif (p.online === true) {\n  msg.payload = '[' + devId + '] 🟢 Online' + (p.fw ? ' — FW ' + p.fw : '');\n} else {\n  msg.payload = '[' + devId + '] 🔴 Offline';\n}\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 310,
    "y": 200,
    "wires": [["node-text-online"]]
  },

