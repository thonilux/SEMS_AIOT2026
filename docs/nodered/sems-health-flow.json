[
  {
    "id": "sems-health-tab",
    "type": "tab",
    "label": "SEMS Health Monitor",
    "disabled": false,
    "info": "Subscribe ke MQTT sems/health dari SEMS AIoT ESP32.\nPayload: {up, heap, rssi, ip, if, time}"
  },

  {
    "id": "sems-mqtt-broker",
    "type": "mqtt-broker",
    "name": "SEMS Broker (iotlab)",
    "broker": "128.199.206.166",
    "port": "1883",
    "clientid": "nodered-sems-monitor",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "credentials": {
      "user": "user_1",
      "password": "iotlabftuns2023"
    }
  },

  {
    "id": "node-mqtt-in",
    "type": "mqtt in",
    "z": "sems-health-tab",
    "name": "sems/+/health",
    "topic": "sems/+/health",
    "qos": "0",
    "datatype": "json",
    "broker": "sems-mqtt-broker",
    "nl": false,
    "rap": false,
    "x": 120,
    "y": 100,
    "wires": [["node-split-fields", "node-debug-raw"]]
  },

  {
    "id": "node-debug-raw",
    "type": "debug",
    "z": "sems-health-tab",
    "name": "raw payload",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 320,
    "y": 60,
    "wires": []
  },

  {
    "id": "node-split-fields",
    "type": "function",
    "z": "sems-health-tab",
    "name": "extract fields",
    "func": "const p = msg.payload;\nconst devId = msg.topic.split('/')[1] || '?';\n\n// Uptime: detik → HH:MM:SS\nconst s = p.up % 60;\nconst m = Math.floor(p.up / 60) % 60;\nconst h = Math.floor(p.up / 3600);\nconst upStr = `[${devId}] ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;\n\n// Heap: bytes → KB, 1 decimal\nconst heapKb = parseFloat((p.heap / 1024).toFixed(1));\n\n// RSSI bar: -100..0 dBm → 0..100%\nconst rssiPct = p.rssi < 0 ? Math.max(0, Math.min(100, 100 + p.rssi)) : 0;\n\n// Chart format untuk ui_chart (series per device)\nconst chartMsg = {\n  payload: [{ series: [devId], data: [[{ x: Date.now(), y: heapKb }]], labels: [''] }]\n};\n\nreturn [\n  { payload: upStr      },\n  { payload: heapKb     },\n  { payload: p.rssi     },\n  { payload: rssiPct    },\n  { payload: p.ip       },\n  { payload: p.if       },\n  { payload: p.time     },\n  chartMsg\n];\n",
    "outputs": 8,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 120,
    "wires": [
      ["node-text-uptime"],
      ["node-gauge-heap"],
      ["node-text-rssi"],
      ["node-gauge-rssi"],
      ["node-text-ip"],
      ["node-text-iface"],
      ["node-text-time"],
      ["node-status-bar"]
    ]
  },

  {
    "id": "ui-group-sems",
    "type": "ui_group",
    "name": "SEMS AIoT",
    "tab": "ui-tab-sems",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
